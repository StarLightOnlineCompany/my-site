<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StarLight</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        :root {
            --bg: #000;
            --bg-alt: #0a0a0a;
            --text: #f5f5f7;
            --text-dim: #86868b;
            --accent: #0071e3;
            --accent-hover: #0077ed;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
            line-height: 1.47059;
            letter-spacing: -0.022em;
        }

        /* ============ NAV ============ */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 48px;
            background: rgba(0, 0, 0, 0.72);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .nav-inner {
            width: 100%;
            max-width: 1024px;
            padding: 0 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            font-size: 17px;
            font-weight: 600;
            color: var(--text);
            text-decoration: none;
            letter-spacing: -0.02em;
        }

        .nav-links {
            display: flex;
            gap: 32px;
            list-style: none;
        }

        .nav-links a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 12px;
            font-weight: 400;
            transition: color 0.3s ease;
        }

        .nav-links a:hover { color: #fff; }

        /* ============ HERO ============ */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 120px 22px 80px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(0, 113, 227, 0.15) 0%, transparent 60%);
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            animation: pulse 8s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
        }

        .hero-eyebrow {
            font-size: 21px;
            font-weight: 600;
            color: var(--text-dim);
            margin-bottom: 6px;
            letter-spacing: -0.01em;
            position: relative;
            z-index: 1;
        }

        .hero h1 {
            font-size: clamp(48px, 9vw, 112px);
            font-weight: 700;
            line-height: 1.05;
            letter-spacing: -0.04em;
            margin-bottom: 20px;
            background: linear-gradient(180deg, #fff 0%, #a1a1a6 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
            z-index: 1;
        }

        .hero p {
            font-size: clamp(19px, 2vw, 24px);
            color: var(--text-dim);
            max-width: 640px;
            margin: 0 auto 40px;
            font-weight: 400;
            line-height: 1.4;
            position: relative;
            z-index: 1;
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 980px;
            font-size: 17px;
            font-weight: 400;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            font-family: inherit;
            position: relative;
            z-index: 1;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
            transform: scale(1.02);
        }

        .btn-link {
            color: var(--accent);
            background: transparent;
            padding: 12px 8px;
        }

        .btn-link:hover { text-decoration: underline; }

        .hero-cta {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* ============ SECTIONS ============ */
        section { padding: 140px 22px; position: relative; }

        .container {
            max-width: 1024px;
            margin: 0 auto;
            width: 100%;
        }

        .section-eyebrow {
            font-size: 19px;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 8px;
            letter-spacing: -0.01em;
        }

        .section-title {
            font-size: clamp(40px, 6vw, 72px);
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.05;
            margin-bottom: 24px;
        }

        .section-title span {
            background: linear-gradient(90deg, #0071e3, #64b5ff);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-desc {
            font-size: 21px;
            color: var(--text-dim);
            max-width: 680px;
            line-height: 1.4;
            font-weight: 400;
        }

        /* ============ STAR PAY ============ */
        .pay-section { background: var(--bg); }

        .pay-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            margin-top: 80px;
        }

        .pay-features {
            list-style: none;
            margin-top: 40px;
        }

        .pay-features li {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 20px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 17px;
            color: var(--text);
        }

        .pay-features li:last-child { border-bottom: none; }

        .pay-features .icon {
            color: var(--accent);
            font-size: 20px;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .card-stage {
            perspective: 1200px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 400px;
        }

        .credit-card {
            width: 380px;
            height: 240px;
            border-radius: 18px;
            background: linear-gradient(135deg, #1c1c1e 0%, #2c2c2e 100%);
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 30px 60px rgba(0, 0, 0, 0.6),
                0 0 0 1px rgba(255, 255, 255, 0.08) inset;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }

        .credit-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 20%, rgba(0, 113, 227, 0.3), transparent 50%);
            pointer-events: none;
        }

        .credit-card:hover {
            transform: rotateY(-8deg) rotateX(8deg) translateY(-4px);
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            position: relative;
            z-index: 1;
        }

        .card-brand {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: #fff;
        }

        .card-chip {
            width: 42px;
            height: 30px;
            background: linear-gradient(135deg, #d4af37 0%, #b8941f 100%);
            border-radius: 6px;
            position: relative;
        }

        .card-chip::after {
            content: '';
            position: absolute;
            inset: 6px 10px;
            border: 1px solid rgba(0,0,0,0.2);
            border-radius: 2px;
        }

        .card-number {
            font-family: "SF Mono", "Courier New", monospace;
            font-size: 20px;
            letter-spacing: 3px;
            color: #fff;
            font-weight: 400;
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .card-bottom {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.6);
            position: relative;
            z-index: 1;
        }

        /* ============ TELEGRAM ============ */
        .bot-section {
            background: var(--bg-alt);
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .bot-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            margin-top: 60px;
        }

        .phone-stage { display: flex; justify-content: center; }

        .phone {
            width: 300px;
            height: 620px;
            background: #000;
            border-radius: 46px;
            padding: 10px;
            box-shadow:
                0 40px 80px rgba(0, 0, 0, 0.7),
                0 0 0 2px rgba(255, 255, 255, 0.1) inset;
            position: relative;
        }

        .phone::before {
            content: '';
            position: absolute;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 26px;
            background: #000;
            border-radius: 20px;
            z-index: 10;
        }

        .screen {
            width: 100%;
            height: 100%;
            background: #000;
            border-radius: 38px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .tg-header {
            padding: 50px 16px 14px;
            background: rgba(28, 28, 30, 0.95);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-decoration: none;
            color: inherit;
        }

        .tg-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0071e3, #64b5ff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #fff;
            font-size: 16px;
        }

        .tg-name {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .tg-status {
            font-size: 12px;
            color: #30d158;
            margin-top: 1px;
        }

        .chat-area {
            flex: 1;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: #000;
            overflow-y: auto;
        }

        .chat-area::-webkit-scrollbar { display: none; }

        .message {
            max-width: 82%;
            padding: 9px 14px;
            border-radius: 18px;
            font-size: 13px;
            line-height: 1.35;
            color: #fff;
            animation: msgIn 0.4s ease;
        }

        .msg-bot {
            background: #1c1c1e;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }

        .msg-user {
            background: #0071e3;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }

        @keyframes msgIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .keyboard {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

        .kb-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #64b5ff;
            padding: 7px 12px;
            border-radius: 14px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .kb-btn:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.03);
        }

        /* ============ FAQ ============ */
        .faq-section {
            background: var(--bg);
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .faq-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .faq-list {
            max-width: 820px;
            margin: 0 auto;
        }

        .faq-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .faq-item:first-child {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .faq-question {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text);
            font-family: inherit;
            font-size: 19px;
            font-weight: 500;
            letter-spacing: -0.01em;
            text-align: left;
            padding: 28px 0;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            transition: color 0.25s ease;
        }

        .faq-question:hover { color: var(--accent); }

        .faq-icon {
            flex-shrink: 0;
            width: 24px;
            height: 24px;
            position: relative;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .faq-icon::before,
        .faq-icon::after {
            content: '';
            position: absolute;
            background: var(--text-dim);
            border-radius: 2px;
            transition: background 0.25s ease;
        }

        .faq-icon::before {
            width: 14px;
            height: 2px;
            top: 11px;
            left: 5px;
        }

        .faq-icon::after {
            width: 2px;
            height: 14px;
            top: 5px;
            left: 11px;
        }

        .faq-question:hover .faq-icon::before,
        .faq-question:hover .faq-icon::after {
            background: var(--accent);
        }

        .faq-item.open .faq-icon { transform: rotate(45deg); }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .faq-answer-inner {
            padding: 0 40px 28px 0;
            font-size: 17px;
            line-height: 1.55;
            color: var(--text-dim);
        }

        .faq-answer-inner a {
            color: var(--accent);
            text-decoration: none;
        }

        .faq-answer-inner a:hover { text-decoration: underline; }

        /* ============ COOKIE BANNER ============ */
        .cookie-banner {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(150%);
            width: calc(100% - 40px);
            max-width: 960px;
            background: rgba(28, 28, 30, 0.92);
            backdrop-filter: saturate(180%) blur(24px);
            -webkit-backdrop-filter: saturate(180%) blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 22px 26px;
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                        opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
        }

        .cookie-banner.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        .cookie-text {
            flex: 1;
            min-width: 260px;
            font-size: 14px;
            color: var(--text-dim);
            line-height: 1.45;
        }

        .cookie-text strong {
            color: var(--text);
            display: block;
            font-size: 15px;
            margin-bottom: 4px;
            font-weight: 600;
        }

        .cookie-text a {
            color: var(--accent);
            text-decoration: none;
        }

        .cookie-text a:hover { text-decoration: underline; }

        .cookie-actions {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        .cookie-btn {
            padding: 10px 20px;
            border-radius: 980px;
            font-size: 14px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.25s ease;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: transparent;
            color: var(--text);
        }

        .cookie-btn:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .cookie-btn.accept {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        .cookie-btn.accept:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }

        /* ============ FOOTER ============ */
        footer {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding: 40px 22px;
            font-size: 12px;
            color: var(--text-dim);
            text-align: center;
        }

        .footer-inner {
            max-width: 1024px;
            margin: 0 auto;
        }

        .footer-inner a {
            color: var(--accent);
            text-decoration: none;
        }

        .footer-inner a:hover { text-decoration: underline; }

        /* ============ ANIMATION ============ */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
                        transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 820px) {
            .nav-links { display: none; }
            .pay-grid, .bot-grid {
                grid-template-columns: 1fr;
                gap: 60px;
            }
            section { padding: 90px 22px; }
            .credit-card { width: 320px; height: 200px; padding: 22px; }
            .card-number { font-size: 16px; letter-spacing: 2px; }
            .phone { width: 280px; height: 580px; }
            .cookie-banner { padding: 18px; bottom: 12px; }
            .cookie-actions { width: 100%; }
            .cookie-btn { flex: 1; text-align: center; }
            .faq-question { font-size: 17px; padding: 24px 0; }
            .faq-answer-inner { font-size: 15px; padding-right: 20px; }
        }
    </style>
</head>
<body>

    <!-- NAV -->
    <nav>
        <div class="nav-inner">
            <a href="#" class="nav-logo"> StarLight</a>
            <ul class="nav-links">
                <li><a href="#pay">Star Pay</a></li>
                <li><a href="#bot">Telegram Bot</a></li>
                <li><a href="#faq">FAQ</a></li>
                <li><a href="https://t.me/starlightonlinebot" target="_blank" rel="noopener">@starlightonlinebot</a></li>
            </ul>
        </div>
    </nav>

    <!-- HERO -->
    <header class="hero">
        <div class="hero-eyebrow">StarLight</div>
        <h1>Будущее уже<br>наступило.</h1>
        <p>Экосистема финансовых решений нового поколения. Star Pay, умный Telegram-бот и полный контроль над деньгами.</p>
        <div class="hero-cta">
            <a href="#pay" class="btn btn-primary">Узнать больше</a>
            <a href="https://t.me/starlightonlinebot" target="_blank" rel="noopener" class="btn btn-link">Открыть бота ›</a>
        </div>
    </header>

    <!-- STAR PAY -->
    <section id="pay" class="pay-section">
        <div class="container">
            <div class="reveal">
                <div class="section-eyebrow">Star Pay</div>
                <h2 class="section-title">Ваш кошелёк.<br><span>Везде с вами.</span></h2>
                <p class="section-desc">Виртуальная карта, которая живёт в телефоне. Мгновенные переводы, оплата в один клик и полная безопасность.</p>
            </div>

            <div class="pay-grid">
                <div class="reveal">
                    <ul class="pay-features">
                        <li>
                            <span class="icon"><i class="fas fa-bolt"></i></span>
                            <div>
                                <strong>Мгновенные переводы</strong><br>
                                <span style="color: var(--text-dim); font-size: 15px;">По всему миру за секунды</span>
                            </div>
                        </li>
                        <li>
                            <span class="icon"><i class="fas fa-star"></i></span>
                            <div>
                                <strong>Кэшбэк звёздными баллами</strong><br>
                                <span style="color: var(--text-dim); font-size: 15px;">До 5% с каждой покупки</span>
                            </div>
                        </li>
                        <li>
                            <span class="icon"><i class="fas fa-shield-halved"></i></span>
                            <div>
                                <strong>Face ID и биометрия</strong><br>
                                <span style="color: var(--text-dim); font-size: 15px;">Ваши данные под защитой</span>
                            </div>
                        </li>
                        <li>
                            <span class="icon"><i class="fab fa-telegram"></i></span>
                            <div>
                                <strong>Интеграция с Telegram</strong><br>
                                <span style="color: var(--text-dim); font-size: 15px;">Управляйте картой прямо в чате</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="card-stage reveal">
                    <div class="credit-card">
                        <div class="card-top">
                            <div class="card-brand">Star&nbsp;Pay</div>
                            <div class="card-chip"></div>
                        </div>
                        <div class="card-number">•••• •••• •••• 2024</div>
                        <div class="card-bottom">
                            <span>STAR USER</span>
                            <span>12/28</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TELEGRAM BOT -->
    <section id="bot" class="bot-section">
        <div class="container">
            <div class="reveal" style="text-align: center;">
                <div class="section-eyebrow">Telegram Bot</div>
                <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Все под контролем.</h2>
                <p class="section-desc" style="margin: 0 auto;">Личный ассистент в Telegram. Баланс, переводы, оплата счетов — без лишних приложений.</p>
            </div>

            <div class="bot-grid">
                <div class="phone-stage reveal">
                    <div class="phone">
                        <div class="screen">
                            <a href="https://t.me/starlightonlinebot" target="_blank" rel="noopener" class="tg-header">
                                <div class="tg-avatar">S</div>
