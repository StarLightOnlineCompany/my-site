    <!-- COOKIE BANNER -->
    <div class="cookie-banner" id="cookieBanner" role="dialog" aria-live="polite" aria-label="Использование cookies">
        <div class="cookie-text">
            <strong>Мы используем cookies 🍪</strong>
            StarLight использует cookies, чтобы сайт работал быстрее и был удобнее для вас. Продолжая пользоваться сайтом, вы соглашаетесь с
            <a href="#privacy">политикой конфиденциальности</a>.
        </div>
        <div class="cookie-actions">
            <button class="cookie-btn" id="cookieDecline">Только необходимые</button>
            <button class="cookie-btn accept" id="cookieAccept">Принять все</button>
        </div>
    </div>

    <script>
        // ============ Reveal-анимации ============
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('visible');
            });
        }, { threshold: 0.12 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // ============ FAQ аккордеон ============
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            const answer = item.querySelector('.faq-answer');

            question.addEventListener('click', () => {
                const isOpen = item.classList.contains('open');

                // Закрываем все остальные (как на apple.com)
                faqItems.forEach(other => {
                    if (other !== item) {
                        other.classList.remove('open');
                        other.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
                        other.querySelector('.faq-answer').style.maxHeight = null;
                    }
                });

                // Переключаем текущий
                if (isOpen) {
                    item.classList.remove('open');
                    question.setAttribute('aria-expanded', 'false');
                    answer.style.maxHeight = null;
                } else {
                    item.classList.add('open');
                    question.setAttribute('aria-expanded', 'true');
                    answer.style.maxHeight = answer.scrollHeight + 'px';
                }
            });
        });

        // ============ Cookie banner ============
        const cookieBanner = document.getElementById('cookieBanner');
        const cookieAccept = document.getElementById('cookieAccept');
        const cookieDecline = document.getElementById('cookieDecline');
        const COOKIE_KEY = 'starlight_cookie_choice';

        function hideCookieBanner(choice) {
            localStorage.setItem(COOKIE_KEY, choice);
            cookieBanner.classList.remove('show');
            setTimeout(() => { cookieBanner.style.display = 'none'; }, 600);
        }

        // Показываем баннер, только если выбор ещё не сделан
        if (!localStorage.getItem(COOKIE_KEY)) {
            setTimeout(() => cookieBanner.classList.add('show'), 1500);
        } else {
            cookieBanner.style.display = 'none';
        }

        cookieAccept.addEventListener('click', () => hideCookieBanner('all'));
        cookieDecline.addEventListener('click', () => hideCookieBanner('necessary'));

        // ============ Demo-клики в телефоне ============
        document.querySelectorAll('.kb-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                btn.style.transform = 'scale(0.96)';
                setTimeout(() => btn.style.transform = '', 120);
            });
        });
    </script>
